{
    "use-geolocation": {
        "type": "checkbox",
        "default": true,
        "description": "Auto-detect current location on startup",
        "tooltip": "Uses IP-based geolocation. Falls back to default favorite if unavailable."
    },
    "units": {
        "type": "combobox",
        "default": "F",
        "description": "Temperature Units",
        "options": {
            "Fahrenheit (°F)": "F",
            "Celsius (°C)": "C"
        }
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 30,
        "min": 10,
        "max": 120,
        "step": 5,
        "units": "minutes",
        "description": "Weather Refresh Interval"
    },
    "default-favorite": {
        "type": "spinbutton",
        "default": 1,
        "min": 1,
        "max": 5,
        "step": 1,
        "description": "Default Favorite (1-5)",
        "tooltip": "Which favorite to show when geolocation is off or unavailable"
    },
    "show-space-wx": {
        "type": "checkbox",
        "default": true,
        "description": "Show Space Weather section",
        "tooltip": "Displays K-index, SFI, X-ray flux, solar wind from NOAA SWPC"
    },
    "show-band-conditions": {
        "type": "checkbox",
        "default": true,
        "description": "Show Band Conditions section",
        "tooltip": "Displays HF/VHF band condition estimates derived from K-index and SFI"
    },
    "show-7day": {
        "type": "checkbox",
        "default": true,
        "description": "Show 7-Day Forecast strip",
        "tooltip": "When hidden the desklet collapses to current conditions only"
    },
    "fav1-name": {
        "type": "entry",
        "default": "Columbus, OH",
        "description": "Favorite 1 — Name"
    },
    "fav1-lat": {
        "type": "entry",
        "default": "39.9833",
        "description": "Favorite 1 — Latitude"
    },
    "fav1-lon": {
        "type": "entry",
        "default": "-82.9833",
        "description": "Favorite 1 — Longitude"
    },
